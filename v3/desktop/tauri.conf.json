{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "QuickClip321",
    "version":  "3.0.0-beta.7",
    "identifier":  "com.tuna321.quickclip321.v3",
    "build":  {
                  "frontendDist":  "../ui"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "QuickClip321",
                                    "width":  600,
                                    "height":  420,
                                    "minWidth":  500,
                                    "minHeight":  350,
                                    "visible":  false,
                                    "resizable":  false,
                                    "skipTaskbar":  true,
                                    "decorations":  false,
                                    "alwaysOnTop":  true,
                                    "shadow":  false,
                                    "backgroundColor":  "#151620"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027; img-src \u0027self\u0027 data:; connect-src ipc: http://ipc.localhost"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/icon.ico"
                            ]
               }
}