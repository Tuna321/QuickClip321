{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickClip321",
  "version": "3.0.0-alpha.1",
  "identifier": "com.tuna321.quickclip321.v3",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuickClip321",
        "width": 960,
        "height": 700,
        "minWidth": 500,
        "minHeight": 470,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}